<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ألبوم الصور الذكريات</title>
    <style>
        /* ================= التنسيقات العامة ================= */
        body {
            margin: 0;
            padding: 20px;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
        }

        h1 {
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        /* ================= زر وأداة الصوت ================= */
        .controls {
            margin-bottom: 20px;
            z-index: 10;
        }

        .music-btn, .heart-btn {
            padding: 12px 25px;
            font-size: 16px;
            font-weight: bold;
            color: white;
            background: linear-gradient(45deg, #ff4b2b, #ff416c);
            border: none;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 65, 108, 0.4);
            transition: transform 0.2s, background 0.3s;
            margin: 5px;
        }

        .music-btn:hover, .heart-btn:hover {
            transform: scale(1.05);
        }

        /* ================= حاوية كتاب الصور ================= */
        .book-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 420px;
            width: 100%;
            perspective: 1200px;
            margin-top: 20px;
            position: relative;
        }

        .book {
            position: relative;
            width: 250px;
            height: 330px;
            transform-style: preserve-3d;
            transition: transform 1s;
        }

        /* تصميم صفحات الكتاب */
        .page {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
            cursor: pointer;
            transform-origin: left center;
            transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.8s, top 1s, left 1s, width 1s, height 1s;
            background: #fff;
            border: 4px solid #fff;
            box-sizing: border-box;
        }

        .page img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* حركة تقليب الصفحة */
        .page.flipped {
            transform: rotateY(-140deg);
            pointer-events: none;
        }

        /* ================= نمط التجميع على شكل قلب ================= */
        .book.heart-shape {
            width: 100%;
            height: 480px;
        }

        .book.heart-shape .page {
            width: 75px;
            height: 95px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(255, 65, 108, 0.6);
            transform: rotateY(0deg) !important;
        }
    </style>
</head>
<body>

    <h1>✨ ألبوم الذكريات الجميلة ✨</h1>

    <!-- مشغل الصوت من ملف الفيديو MP4 -->
    <audio id="bg-music" loop preload="auto">
        <source src="كل سنة.mp4" type="video/mp4">
    </audio>

    <!-- أدوات التحكم -->
    <div class="controls">
        <button class="music-btn" id="musicBtn" onclick="toggleMusic()">🎵 تشغيل الموسيقى</button>
        <button class="heart-btn" onclick="arrangeInHeart()">❤️ تجميع في شكل قلب الآن</button>
    </div>
    
    <!-- حاوية كتاب الصور (10 صور) -->
    <div class="book-container">
        <div class="book" id="photoBook">
            <!-- ضع أرقام وأسماء الصور الخاصة بك هنا -->
            <div class="page"><img src="1.jpg" alt="صقر.jpeg"></div>
            <div class="page"><img src="2.jpg" alt="صقر 2.jpeg "></div>
            <div class="page"><img src="3.jpg" alt="صقر 4.jpeg"></div>
            <div class="page"><img src="4.jpg" alt=" صقر 3.jpeg"></div>
            <div class="page"><img src="5.jpg" alt="WhatsApp Image 2026-10-08 at 1.15.37 AM (3).jpeg"></div>
            <div class="page"><img src="6.jpg" alt=" صقر 5.jpeg"></div>
            <div class="page"><img src="7.jpg" alt=" صقر 6.jpeg - Shortcut"></div>
            <div class="page"><img src="8.jpg" alt="WhatsApp Image 2026-10-08 at 1.15.34 AM.jpeg"></div>
            <div class="page"><img src="9.jpg" alt=" WhatsApp Image 2026-10-08 at 1.15.37 AM (2).jpeg"></div>
            <div class="page"><img src="10.jpg" alt=" WhatsApp Image 2026-10-08 at 1.15.37 AM (1).jpeg"></div>
        </div>
    </div>

    <!-- ================= البرمجة (JavaScript) ================= -->
    <script>
        let currentPageIndex = 0;
        const pages = document.querySelectorAll('.page');
        let autoFlipInterval;

        // 1. تقليب صفحة واحدة تلقائياً
        function autoFlipNextPage() {
            if (currentPageIndex < pages.length) {
                pages[currentPageIndex].classList.add('flipped');
                currentPageIndex++;
            } else {
                // إيقاف التقليب وتجميع الصور في شكل قلب عند الانتهاء من الـ 10 صور
                clearInterval(autoFlipInterval);
                setTimeout(arrangeInHeart, 1000);
            }
        }

        // 2. تشغيل التقليب التلقائي بمجرد فتح الصفحة (كل 3 ثوانٍ)
        window.onload = function() {
            autoFlipInterval = setInterval(autoFlipNextPage, 3000);
        };

        // 3. تشغيل وإيقاف الموسيقى من ملف الفيديو
        function toggleMusic() {
            const audio = document.getElementById('bg-music');
            const btn = document.getElementById('musicBtn');
            if (audio.paused) {
                audio.play();
                btn.innerHTML = "⏸️ إيقاف الموسيقى";
            } else {
                audio.pause();
                btn.innerHTML = "🎵 تشغيل الموسيقى";
            }
        }

        // 4. ترتيب الـ 10 صور على شكل قلب
        function arrangeInHeart() {
            clearInterval(autoFlipInterval); // إيقاف أي تقليب متبقي
            const book = document.getElementById('photoBook');
            book.classList.add('heart-shape');

            // إحداثيات رسم شكل قلب لـ 10 صور
            const heartPositions = [
                { top: '80px',  left: 'calc(50% - 120px)' }, // أقصى اليسار أعلى
                { top: '40px',  left: 'calc(50% - 65px)'  },
                { top: '80px',  left: 'calc(50% - 10px)'  }, // منتصف أعلى القلب
                { top: '40px',  left: 'calc(50% + 45px)'  },
                { top: '80px',  left: 'calc(50% + 100px)' }, // أقصى اليمين أعلى
                { top: '170px', left: 'calc(50% + 75px)'  },
                { top: '250px', left: 'calc(50% + 35px)'  },
                { top: '330px', left: 'calc(50% - 10px)'  }, // أسفل القلب (الرأس)
                { top: '250px', left: 'calc(50% - 55px)'  },
                { top: '170px', left: 'calc(50% - 95px)'  }
            ];

            pages.forEach((page, index) => {
                page.classList.remove('flipped'); // إعادة الصفحات لوضعها الطبيعي
                setTimeout(() => {
                    page.style.top = heartPositions[index].top;
                    page.style.left = heartPositions[index].left;
                }, index * 120); // حركة انسيابية متتالية لكل صورة
            });
        }
    </script>
</body>
</html>